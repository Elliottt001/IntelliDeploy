{
  "name": "frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "test:visual:mobile": "playwright test --config playwright.mobile.config.ts --grep @visual",
    "visual:compare:mobile": "node scripts/compare-mobile-visuals.mjs",
    "verify:mobile": "npm test && npm run typecheck && npm run test:e2e:mobile && npm run visual:compare:mobile"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@intellideploy/api-client": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "autoprefixer": "^10.5.0",
    "axios": "^1.13.6",
    "expo": "~55.0.23",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.19",
    "expo-font": "~55.0.7",
    "expo-linear-gradient": "^55.0.13",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "nativewind": "^4.2.4",
    "postcss": "^8.5.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-css-interop": "^0.2.4",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^55.0.21",
    "happy-dom": "^21.0.4",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-native-svg-transformer": "^1.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
