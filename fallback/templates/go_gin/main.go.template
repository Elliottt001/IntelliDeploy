package main

import (
	"net/http"
	"os"

	"github.com/gin-gonic/gin"
)

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "{{port}}"
	}
	router := gin.Default()
	router.GET("/", func(c *gin.Context) { c.String(http.StatusOK, "{{app_name}}") })
	router.GET("/health", func(c *gin.Context) { c.JSON(http.StatusOK, gin.H{"ok": true}) })
	router.Run("0.0.0.0:" + port)
}
