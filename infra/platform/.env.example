# Compose interpolation only; keep the filled file outside Git with mode 600.
PLATFORM_ENV_FILE=/etc/intellideploy/platform.runtime.env
CREDENTIALS_DIR=/etc/intellideploy/credentials
PLATFORM_DOMAIN=platform.example.test
API_DOMAIN=api.example.test
PUBLIC_API_DOCS=false
PLATFORM_API_IMAGE=intellideploy-api:local
PLATFORM_WEB_IMAGE=intellideploy-web:local
NODE_IMAGE=node:24-bookworm-slim
POSTGRES_IMAGE=postgres:17
POSTGRES_TOOLS_IMAGE=postgres:17-bookworm
CADDY_IMAGE=caddy:2
