ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package.json
COPY web/package.json web/package.json
COPY packages/api-client/package.json packages/api-client/package.json
RUN npm ci
COPY packages/api-client packages/api-client
COPY web web
COPY scaffolds scaffolds
RUN npm --workspace @intellideploy/api-client run build && npm --workspace web exec -- next build --webpack

FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/web/.next/standalone ./
COPY --from=build --chown=node:node /app/web/public ./web/public
COPY --from=build --chown=node:node /app/web/.next/static ./web/.next/static
USER node
CMD ["node", "web/server.js"]
