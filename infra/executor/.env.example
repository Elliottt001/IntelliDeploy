# Compose interpolation; replace image tags with approved OCI digests on the node.
RUNNER_ENV_FILE=/etc/intellideploy/runner.runtime.env
RUNNER_WORKSPACE_ROOT=/var/lib/intellideploy-runner
RUNNER_CREDENTIALS_DIR=/etc/intellideploy/runner-credentials
REGISTRY_CONFIG_DIR=/etc/intellideploy/registry
RUNNER_IMAGE=intellideploy-runner:local
PLATFORM_API_IMAGE=intellideploy-api:local
BUILDKIT_IMAGE=moby/buildkit:latest
CRANE_IMAGE=gcr.io/go-containerregistry/crane:debug
DOCKER_CLI_IMAGE=docker:cli
RUNTIME_PROXY_IMAGE=intellideploy-proxy:local
CADDY_IMAGE=caddy:2
CANDIDATE_DOMAIN_SUFFIX=candidate.example.test
DEPENDENCY_ALLOWED_HOSTS=registry.npmjs.org,pypi.org,files.pythonhosted.org
