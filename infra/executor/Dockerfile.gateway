FROM python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72
WORKDIR /platform
COPY backend/requirements.txt /platform/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 runner
COPY backend/app /platform/app
ENV PYTHONPATH=/platform
USER 10001:10001
CMD ["python", "-m", "app.runner.proxy"]
